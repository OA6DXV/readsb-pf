# readsb-pf service for systemd

[Unit]
Description=readsb-pf ADS-B receiver
Documentation=https://github.com/OA6DXV/readsb-pf
Wants=network.target
After=network.target

[Service]
EnvironmentFile=/etc/default/readsb-pf
User=readsb-pf
RuntimeDirectory=readsb-pf
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/readsb-pf --write-json /run/readsb-pf --quiet $RECEIVER_OPTIONS $DECODER_OPTIONS $NET_OPTIONS $JSON_OPTIONS
Type=simple
Restart=always
RestartSec=15
StartLimitInterval=1
StartLimitBurst=100
Nice=-5

[Install]
WantedBy=default.target
